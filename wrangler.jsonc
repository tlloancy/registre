{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "registre",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "registre.formation.deter-mi.net",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "registre",
      "database_id": "9005795a-14a1-4294-b3c7-034ff80849b8",
      "migrations_dir": "migrations"
    }
  ]
}
