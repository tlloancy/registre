{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "registre",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "registre.formation.deter-mi.net",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "registre",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FICHIERS",
      "bucket_name": "registre"
    }
  ]
}
